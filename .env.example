# Copy to .env.local for local dev. In GitHub, add these as repository secrets (Settings → Secrets → Actions).
# Leave VITE_SUPABASE_URL empty to run in local demo mode (data stays on this device only).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
VITE_GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=YOUR-PICKER-API-KEY
VITE_GOOGLE_APP_ID=YOUR-GOOGLE-CLOUD-PROJECT-NUMBER
